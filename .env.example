# 后端 = Cloudflare Workers + D1。前端与 Worker 同源部署时无需填写；
# 本地 npm run dev 会由 vite 把 /api 代理到 wrangler dev（127.0.0.1:8787）。
# 仅当 Worker 部署在独立域名时才需要：
VITE_API_BASE_URL=

# Optional: default OpenAI-compatible endpoint. Leave blank to use https://api.openai.com/v1
VITE_OPENAI_BASE_URL=

# Optional: default model names (override in-app under 设置)
VITE_CHAT_MODEL=gpt-4o-mini
VITE_WHISPER_MODEL=whisper-1

# PC 端后台同步（scripts/sync-lists.mjs / sync-footprints.mjs）：共享账号登录凭据，仅本机脚本使用，不会进入前端构建产物
# MENGYA_API_BASE 为 Worker 地址（留空则回退到 VITE_API_BASE_URL）
MENGYA_API_BASE=
MENGYA_EMAIL=your-shared-account@example.com
MENGYA_PASSWORD=your-password