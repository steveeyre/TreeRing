{
  "name": "treering",
  "private": true,
  "version": "1.0.0",
  "description": "TreeRing（小年轮）· AI 育儿记录 PWA",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node scripts/test.mjs",
    "gen-icons": "node scripts/gen-icons.mjs",
    "dev:api": "wrangler dev --config wrangler.worker.toml --port 8787 --ip 127.0.0.1",
    "deploy": "npm run build && wrangler pages deploy",
    "deploy:worker": "npm run build && wrangler deploy --config wrangler.worker.toml",
    "lists:dry": "node scripts/sync-lists.mjs --dry-run",
    "lists:sync": "node scripts/sync-lists.mjs",
    "footprints:dry": "node scripts/sync-footprints.mjs --dry-run",
    "footprints:sync": "node scripts/sync-footprints.mjs"
  },
  "dependencies": {
    "html-to-image": "^1.11.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vite-plugin-pwa": "^0.20.5",
    "wrangler": "^4.151.1"
  }
}
